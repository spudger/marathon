(text "Validated architecture from breadboard; bare-IC support circuits added from manufacturer references." (exclude_from_sim no) (at 30.48 25.40 0) (effects (font (size 1.1 1.1))) (uuid "3cdb0038-39c0-41fb-b562-07f7c4edcdce"))
(text "VERIFY BEFORE PCB: exact LCD FPC pitch/pinout, membrane geometry, switch footprints, IP5306 exposed-pad land pattern." (exclude_from_sim no) (at 30.48 30.48 0) (effects (font (size 1.1 1.1))) (uuid "afa3e000-ab44-43a2-8496-3cd3ffd3c74e"))
(text "PCM5102A is powered from Pi 3.3V (AVDD/CPVDD/DVDD), NOT 5V. SCK/FMT/FLT/DEMP low; XSMT high." (exclude_from_sim no) (at 85.09 20.32 0) (effects (font (size 1.0 1.0))) (uuid "a849040f-0302-4e30-8907-bf85a9ce0cee"))
(text "PAM8403 sourced from Slkor (LCSC C5122557). The Diodes Inc. original is NRND/EOL." (exclude_from_sim no) (at 144.78 20.32 0) (effects (font (size 1.0 1.0))) (uuid "13753cef-42ec-4cca-ad11-2c959bc0a3ad"))
